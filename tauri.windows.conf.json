{
  "build": {
    "beforeBundleCommand": null
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Dervo",
        "width": 1512,
        "height": 945,
        "minWidth": 800,
        "minHeight": 500,
        "transparent": false,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled"
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "backend/*.py",
      "backend/dervo_harness/*",
      "runtime/*",
      "runtime/codex-win/**/*",
      "windows-python/**/*",
      "LICENSE.md",
      "LICENSE-Buzz"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
