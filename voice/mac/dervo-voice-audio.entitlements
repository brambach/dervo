<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The voice audio helper only (voice/mac/main.swift): it reads the microphone under the hardened runtime. Not attached to
     dervo-local itself, whose entitlements stay empty (signing/Dervo.entitlements). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
